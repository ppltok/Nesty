{
  "manifest_version": 3,
  "name": "Add to Nesty Button",
  "version": "1.5.0",
  "description": "הוסיפי מוצרים מכל אתר מסחר אלקטרוני לרשימת הלידה שלך בהקלקה אחת על התוסף",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://nestyil.com/*",
    "https://www.shilav.co.il/*",
    "https://www.motsesim.co.il/*",
    "https://www.baby-shark.co.il/*",
    "https://www.next.co.il/*",
    "https://www2.hm.com/*",
    "https://www.mothercare.co.il/*",
    "https://www.babysafe.co.il/*",
    "https://*.aliexpress.com/*",
    "https://www.zara.com/*",
    "https://www.babyshome.co.il/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://nestyil.com/*"
      ],
      "js": ["detector.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.shilav.co.il/*",
        "https://www.motsesim.co.il/*",
        "https://www.baby-shark.co.il/*",
        "https://www.next.co.il/*",
        "https://www2.hm.com/*",
        "https://www.mothercare.co.il/*",
        "https://www.babysafe.co.il/*",
        "https://*.aliexpress.com/*",
        "https://www.zara.com/*",
        "https://www.babyshome.co.il/*"
      ],
      "js": ["button-injector.js"],
      "css": ["button-styles.css"],
      "run_at": "document_idle",
      "type": "module"
    }
  ],
  "action": {
    "default_title": "Add to Nesty",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["popup-styles.css", "page-script.js", "config.js", "supabase-client.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
