{
  "name": "nesty-video",
  "version": "1.0.0",
  "description": "Nesty promotional video using Remotion",
  "scripts": {
    "start": "npx remotion studio",
    "build": "npx remotion render NestyVideo out/nesty-portrait.mp4",
    "build:landscape": "npx remotion render NestyLandscape out/nesty-landscape.mp4",
    "build:all": "npm run build && npm run build:landscape"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.0",
    "@remotion/cli": "4.0.0",
    "@remotion/renderer": "4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.4"
  }
}
